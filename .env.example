LANGDOCK_API_KEY=""

# Postgres-Direktverbindung — nur fuer `drizzle-kit migrate` lokal.
# Aus Supabase-Dashboard > Project Settings > Database > Connection string > URI
# Beispiel: postgres://postgres:[PASSWORD]@db.cjwgisdobzztljizrnfn.supabase.co:5432/postgres
